    "Administrator",
    "Auctioneer",
    "Bidder",
    "TechnicalSupport"
  ],

  "Swagger": {
    "Title": "Users Microservice - SubastasUCAB",
    "Version": "v1",
    "Endpoint": "/swagger/v1/swagger.json",
    "RoutePrefix": "",
    "Description": "JWT Authorization header using the Bearer scheme.",
    "Authorization": {
      "Name": "Authorization",
      "In": "Header",
      "Type": "ApiKey",
      "Scheme": "Bearer"
